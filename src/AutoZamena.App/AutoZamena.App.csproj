<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>AutoZamena</AssemblyName>
    <RootNamespace>AutoZamena.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Authors>ToshakGulina</Authors>
    <Company>ToshakGulina</Company>
    <Product>AutoZamena</Product>
    <Description>Автозамена опечаток и переключение раскладки клавиатуры для Windows</Description>
    <Copyright>Copyright © 2026 ToshakGulina</Copyright>
    <RepositoryUrl>https://github.com/ToshakGulina/windows-autozamena</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoZamena.Core\AutoZamena.Core.csproj" />
    <InternalsVisibleTo Include="AutoZamena.Tests" />
  </ItemGroup>

</Project>
