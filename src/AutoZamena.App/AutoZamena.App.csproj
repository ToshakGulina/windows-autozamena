<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>AutoZamena</AssemblyName>
    <RootNamespace>AutoZamena.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>ToshakGulina</Authors>
    <Company>AutoZamena Project</Company>
    <Product>AutoZamena</Product>
    <Description>Умная автозамена опечаток на лету и автопереключатель раскладки RU ↔ EN для Windows</Description>
    <Copyright>Copyright © 2026 ToshakGulina (MIT License)</Copyright>
    <RepositoryUrl>https://github.com/ToshakGulina/windows-autozamena</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoZamena.Core\AutoZamena.Core.csproj" />
    <InternalsVisibleTo Include="AutoZamena.Tests" />
  </ItemGroup>

</Project>
